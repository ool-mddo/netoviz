{
  "name": "netoviz",
  "version": "0.2.0",
  "description": "RFC8345-based Network Topology Visualizer",
  "author": "corestate55",
  "private": true,
  "engines": {
    "node": ">=24.x"
  },
  "scripts": {
    "dev": "cross-env NODE_ENV=development nuxt dev",
    "build": "nuxt build",
    "start": "cross-env NODE_ENV=production node .output/server/index.mjs",
    "generate": "nuxt generate",
    "format": "prettier --write '{components,layouts,lib,pages,server,store}/**/*.{js,mjs,vue}'",
    "lint": "eslint --ext .js,.mjs,.vue --ignore-path .gitignore .",
    "lint:fix": "eslint --ext .js,.mjs,.vue --ignore-path .gitignore --fix .",
    "doc": "jsdoc --configure .jsdocrc.json --readme README.md --package package.json",
    "fig": "./bin/gen_fig.rb > fig/classes_js.plantuml && PLANTUML_LIMIT_SIZE=8192 plantuml fig/classes_js.plantuml",
    "docker-build": "docker build -t netoviz/allinone ."
  },
  "dependencies": {
    "@babel/node": "^7.29.7",
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@pinia/nuxt": "^1.0.2",
    "consola": "^3.4.2",
    "cross-env": "^10.1.0",
    "d3-drag": "^3.0.0",
    "d3-fetch": "^3.0.1",
    "d3-force": "^3.0.0",
    "d3-selection": "^3.0.0",
    "d3-shape": "^3.2.0",
    "d3-timer": "^3.0.1",
    "d3-zoom": "^3.0.0",
    "debounce": "^3.0.0",
    "dotenv": "^18.0.4",
    "express": "^4.22.2",
    "h3": "^2.0.1-rc.32",
    "localStorage": "^1.0.4",
    "nuxt": "^4.5.2",
    "pinia": "^4.0.3",
    "vuetify": "^4.2.2"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/eslint-parser": "^7.29.7",
    "@babel/plugin-syntax-dynamic-import": "^7.8.3",
    "@babel/preset-env": "^7.29.7",
    "@nuxtjs/eslint-config": "^11.0.0",
    "@nuxtjs/eslint-module": "^3.1.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^8.10.2",
    "eslint-plugin-prettier": "^4.2.5",
    "foodoc": "0.0.9",
    "jsdoc": "^3.6.11",
    "nodemon": "^3.1.14",
    "prettier": "^2.8.8",
    "prettier-config-standard": "^5.0.0",
    "sass-embedded": "^1.105.0",
    "vite": "^8.3.1",
    "vuetify-nuxt-module": "^1.0.0-rc.6"
  }
}
